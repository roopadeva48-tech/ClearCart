# Secrets & keys — NEVER commit
.env

# Python runtime
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# Database (rebuilt at startup from CSVs)
*.db
*.sqlite
*.sqlite3

# Node
frontend/node_modules/

# OS noise
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

